# Copy this file to .env and fill in real values. Never commit .env.
#
# Google Places API (New) key — server-side only. Used exclusively by the
# Expo Router API route at app/api/nearby-places+api.ts, which runs in
# Node/server context (process.env here is never bundled into the client).
# Do NOT prefix this with EXPO_PUBLIC_ — that would ship it to the client.
#
# Enable "Places API (New)" for a Google Cloud project, create an API key,
# and (for production) restrict it by server IP/referrer as appropriate for
# your hosting setup. See docs/06-data-and-api-plan.md for the verified
# endpoint, pricing, and setup notes.
GOOGLE_PLACES_API_KEY=

# Google Routes API (New) key — server-side only, same rules as above. Used
# exclusively by app/api/route-matrix+api.ts for real, traffic-aware ETA
# (Compute Route Matrix). "Routes API" must be separately enabled in Google
# Cloud Console — it's a distinct product from Places even under the same
# project. Can be the same key value as GOOGLE_PLACES_API_KEY if that key
# has both APIs enabled, or a separate, more tightly restricted key.
GOOGLE_ROUTES_API_KEY=

# Supabase — server-side only, same rules as above (never EXPO_PUBLIC_).
# Used exclusively by app/api/nearby-places+api.ts for the database-first
# mosque lookup (Supabase migration 0009 must be applied first). If unset,
# the route falls back to the previous Google-only behaviour.
SUPABASE_URL=
# Publishable key (sb_publishable_...). Can only call the read-only
# nearby_verified_mosques() function — no table access.
SUPABASE_PUBLISHABLE_KEY=
# Optional secret key (sb_secret_...). Lets the server save confident Google
# Place ID matches via link_google_place_ids(). Highly privileged — server
# env only (EAS "Sensitive"), never in the app. If unset, matches are still
# used in responses but not saved.
SUPABASE_SECRET_KEY=
